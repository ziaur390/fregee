# Example environment file for docker compose.
#
# Copy to .env — .gitignore excludes .env, so this is the only version that
# reaches git. Do not commit a real .env: it holds the Grafana password.
#
#   cp .env.example .env

# --- published host ports -------------------------------------------------
# Parameterised because a development machine usually has something on 8000 and
# 3000 already, and `docker compose up` failing with "port is already
# allocated" is a bad first experience. Change these if a port is taken.
MLSERVE_API_PORT=8000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
ALERT_SINK_PORT=8080
NODE_EXPORTER_PORT=9100

# --- grafana --------------------------------------------------------------
# CHANGE THE PASSWORD before this stack is reachable from anywhere but localhost.
# The default is in the compose file so that `docker compose up` works with no
# configuration at all, which is a deliberate trade for a demo and a bad one for
# anything else.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- jobs -----------------------------------------------------------------
# How often the drift detector runs, and how often a backup is taken and verified.
DRIFT_INTERVAL_SECONDS=300
BACKUP_INTERVAL_SECONDS=3600
